rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidPlace() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name', 'category', 'description', 'address',
          'rating', 'location', 'photoUrl', 'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 60
        && data.location is latlng;
    }

    match /lugares/{lugarId} {
      allow read: if true;
      allow create: if isValidPlace();
      allow update, delete: if request.auth != null
        && resource.data.get('createdBy', '') == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
